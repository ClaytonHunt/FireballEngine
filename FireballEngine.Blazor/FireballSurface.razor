@using FireballEngine.Core
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly

<div @ref="_containerRef" style="width:@(Width)px; height:@(Height)px;">
    <CascadingValue Value="@_context">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }
    [Parameter] public string Title { get; set; } = "Fireball Engine - Game";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _containerRef;
    private IFireballContext? _context;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
            "./_content/FireballEngine.Blazor/fireballBlazor.js");
            _context = new FireballContextBlazor(_module);

            await ((FireballContextBlazor)_context).InitializeAsync(DotNetObjectReference.Create((FireballContextBlazor)_context), _containerRef, Width, Height, Title);

            StateHasChanged();
        }
    }
}