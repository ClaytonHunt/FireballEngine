@using FireballEngine.Blazor.Utilities
@using FireballEngine.Core
@using FireballEngine.Core.Utilities
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly

<div @ref="_containerRef" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" style="width:@(Width)px; height:@(Height)px;"
    tabindex="0">
    <CascadingValue Value="_context">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }
    [Parameter] public string Title { get; set; } = "Fireball Engine - Game";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IGame Game { get; set; } = default!;

    private FireballContextBlazor _context = default!;
    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private BlazorInput _input = new BlazorInput();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Game == null)
            {
                throw new InvalidOperationException("No game instance provided to FireballSurface.");
            }            

            Console.SetOut(new BlazorConsoleWriter(JSRuntime, MessageLevel.Info));            
            Console.SetError(new BlazorConsoleWriter(JSRuntime, MessageLevel.Error));
            Fire.SetFormatter(new BrowserConsoleLogFormatter());

            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/FireballEngine.Blazor/fireballBlazor.js");

            _context = new FireballContextBlazor(_module, Game, _input);

            await _context.InitializeAsync(
                DotNetObjectReference.Create(_context),
                _containerRef,
                Width,
                Height,
                Title
            );

            StateHasChanged();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        _input.OnKeyDown(e);
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        _input.OnKeyUp(e);
    }    
}
