<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.12" PrivateAssets="all" />

    <!-- Conditional reference for local development -->
    <ProjectReference Include="..\FireballEngine.Blazor\FireballEngine.Blazor.csproj" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Conditional reference for NuGet package -->
    <PackageReference Include="FireballEngine.Blazor" Version="0.1.0-alpha" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireballEngine.DemoGame\FireballEngine.DemoGame.csproj" />
  </ItemGroup>  

  <Target Name="SyncGameAssets" AfterTargets="Build">
    <!-- Delete existing assets folder to prevent stale files -->
    <RemoveDir Directories="$(ProjectDir)wwwroot\assets\" Condition="Exists('$(ProjectDir)wwwroot\assets\')" />

    <!-- Recreate the folder to avoid errors -->
    <MakeDir Directories="$(ProjectDir)wwwroot\assets\" />

    <!-- Collect all assets from DemoGame -->
    <ItemGroup>
        <GameAssets Include="..\FireballEngine.DemoGame\assets\**\*" />
    </ItemGroup>

    <!-- Copy assets while preserving the directory structure -->
    <Copy SourceFiles="@(GameAssets)"
          DestinationFolder="$(ProjectDir)wwwroot\assets\%(RecursiveDir)" />
  </Target>
</Project>
